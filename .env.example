# Copy to .env (git-ignored) or export these in your shell before running.

# Gemini API key (https://aistudio.google.com/apikey). Required unless using Vertex AI.
GEMINI_API_KEY=your-gemini-api-key-here

# Use Vertex AI instead of an API key (requires Google Cloud credentials in the environment):
# GOOGLE_GENAI_USE_VERTEXAI=true

# Optional: default SQL database for `python -m epc_parser.staged --db-url ...`
# EPC_DB_URL=sqlite:///epc.db
